########################################################################
# 选品系统 配置样例
# 复制为 .env 后填入真实值：cp .env.example .env   (Windows: copy .env.example .env)
# .env 已在 .gitignore / .vercelignore 中，绝不会被提交或上传
#
# 部署到 Vercel 时不要上传 .env：把下面这些变量名原样填进
# Vercel 控制台 → Project → Settings → Environment Variables 即可。
########################################################################

########################################################################
# 0. 采集收件箱的共享存储（部署到 Vercel 时强烈建议配）
#
#    本地跑是单进程，收件箱放在进程内存里没问题；但 Vercel 是 Serverless，
#    一次采集和随后的轮询很可能落到不同实例，内存不共享，
#    表现就是「提示采集成功了，表格里却一直没有」。
#
#    在 Vercel 控制台 → Storage 里加一个 Redis（Upstash），
#    它会自动注入下面这两组变量，本服务会自动切换过去，不需要改代码：
#      KV_REST_API_URL / KV_REST_API_TOKEN                     （Vercel KV）
#      UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN        （Upstash 直连）
#
#    不配也能跑，只是多实例时采集结果可能时有时无。
#    自检：打开 https://<你的域名>/api/health，看 data.inbox 是 redis 还是 memory。
########################################################################

########################################################################
# 1. Supabase（必填）—— 选品数据全部落在这里
#    位置：Supabase 控制台 → Project Settings → Data API
########################################################################
SUPABASE_URL=https://your-project.supabase.co
# service_role 密钥：绕开 RLS，仅服务端使用。
# 严禁写进前端代码、严禁提交到 git、严禁打印日志。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

########################################################################
# 2. 服务端口 / 对外地址
########################################################################
# API + 静态资源共用一个端口（本地长驻服务用；Vercel 不需要）
PORT=8787
# 开发模式下前端(5173)代理到这个 API 端口
API_PORT=8787
# 可选：本服务对外的完整地址，用于生成采集脚本里的接口地址。
# 部署后建议显式填上（尤其是绑了自定义域名），例如：
#   PUBLIC_BASE_URL=https://sourcing-system.vercel.app
# 不填则按请求的 Host 自动推导（Vercel 上已开 trust proxy，能拿到 https）。
PUBLIC_BASE_URL=

########################################################################
# 3. 亚马逊 —— 官方 Product Advertising API（PA-API 5，合规基线）
#    申请：https://affiliate-program.amazon.com/ → Associates 账号
#    注意：账号需在 30 天内产生过成交，否则 API 调用会返回 429/403
########################################################################
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
# 你的 Associates 追踪 ID，形如 yourname-20
AMAZON_PARTNER_TAG=
# 站点：us / uk / de / jp / ca / fr / it / es / in / com.mx / com.au
AMAZON_MARKETPLACE=us

########################################################################
# 4. TikTok Shop —— 官方开放平台（需已审批的应用 + 卖家授权）
#    申请：https://partner.tiktokshop.com/ → 开发者应用 → 获取授权链接
#    能力边界：主要用于管理「自己店铺」的商品，检索平台全量商品需额外类目权限
########################################################################
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
# 卖家授权后拿到的 access token（有有效期，需定期刷新）
TIKTOK_ACCESS_TOKEN=
# api_gecko=东南亚, api=美区, api-eu=欧盟
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com

########################################################################
# 5. 山姆会员店 —— 无官方商品 API，按「产品类型 → 类目页 → 商品详情」取数
#    只访问 robots 允许的路径：/sitemap.xml、/c/（类目页）、/ip/（商品详情页）
#    samsclub.com/robots.txt 只 Disallow /search，所以绝不自己构造搜索页 URL
########################################################################
# Bright Data API Token：控制台 → Account settings → API tokens
BRIGHTDATA_API_TOKEN=
# Web Unlocker 区域名，控制台默认 web_unblocker1
BRIGHTDATA_ZONE=web_unblocker1

# 选品参考规模控制（调大 = 更慢、更烧额度）
SAMS_PRODUCT_LIMIT=12
SAMS_CATEGORY_LIMIT=3
SAMS_PRODUCT_FETCH_DELAY=800

# 可选：配了数据集就优先用数据集跑关键词（更快、更省额度）；
# 不配则走上面的 sitemap + 类目浏览路径。
SAMS_DATASET_ID=
SAMS_DATASET_INPUT_TEMPLATE={"search_term":"{q}"}
